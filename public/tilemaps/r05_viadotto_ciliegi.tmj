              "type": "string",
              "value": "veloria-field-props-v1"
            },
            {
              "name": "spriteFrame",
              "type": "int",
              "value": 0
            },
            {
              "name": "message",
              "type": "string",
              "value": "Vetracielo è a est, oltre questo ponte. Nella Piazza della Monorotaia trovi un punto cure e rifornimenti. Wooper è di tipo Acqua/Terra: le mosse Elettro non lo colpiscono. Controlla i tipi nel Pokédex."
            }
          ]
        }
      ],
