{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veloria MapDefinition v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "displayName",
    "biomeId",
    "tiledAsset",
    "renderAssets",
    "spawns",
    "connections",
    "encounterTableIds",
    "npcRefs",
    "scriptRefs",
    "musicId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^veloria/[a-z0-9_]+$"
    },
    "version": {
      "type": "integer",
      "const": 2
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "biomeId": {
      "type": "string",
      "minLength": 1
    },
    "tiledAsset": {
      "type": "string",
      "pattern": "\\.tmj$"
    },
    "battleBackgroundKey": {
      "type": "string",
      "minLength": 1
    },
    "renderAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "key", "path"],
            "properties": {
              "kind": { "const": "image" },
              "key": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^assets/(?!.*\\.\\.)[^?]+$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "key", "path", "tiledName", "tileWidth", "tileHeight"],
            "properties": {
              "kind": { "const": "tileset" },
              "key": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^assets/(?!.*\\.\\.)[^?]+$" },
              "tiledName": { "type": "string", "minLength": 1 },
              "tileWidth": { "type": "integer", "minimum": 1 },
              "tileHeight": { "type": "integer", "minimum": 1 }
            }
          }
        ]
      }
    },
    "ambientEffects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count", "area", "colors"],
            "properties": {
              "kind": { "const": "fireflies" },
              "count": { "type": "integer", "minimum": 1, "maximum": 64 },
              "area": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 },
                  "width": { "type": "integer", "minimum": 1 },
                  "height": { "type": "integer", "minimum": 1 }
                }
              },
              "colors": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count", "area", "colors"],
            "properties": {
              "kind": { "const": "water-shimmer" },
              "count": { "type": "integer", "minimum": 1, "maximum": 64 },
              "area": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 },
                  "width": { "type": "integer", "minimum": 1 },
                  "height": { "type": "integer", "minimum": 1 }
                }
              },
              "colors": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "tuftsPerArea", "triggerIds", "colors"],
            "properties": {
              "kind": { "const": "grass-sway" },
              "tuftsPerArea": { "type": "integer", "minimum": 1, "maximum": 16 },
              "triggerIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "colors": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
              }
            }
          }
        ]
      }
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "facing": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ]
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "toMapId",
          "viaSpawnId",
          "targetSpawnId"
        ],
        "additionalProperties": false,
        "properties": {
          "toMapId": {
            "type": "string",
            "minLength": 1
          },
          "viaSpawnId": {
            "type": "string",
            "minLength": 1
          },
          "targetSpawnId": {
            "type": "string",
            "minLength": 1
          },
          "requiresFlags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "encounterTableIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "npcRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scriptRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "musicId": {
      "type": "string",
      "minLength": 1
    }
  }
}
