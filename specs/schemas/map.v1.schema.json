{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veloria MapDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "displayName",
    "biomeId",
    "tiledAsset",
    "spawns",
    "connections",
    "encounterTableIds",
    "npcRefs",
    "scriptRefs",
    "musicId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^veloria/[a-z0-9_]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "biomeId": {
      "type": "string",
      "minLength": 1
    },
    "tiledAsset": {
      "type": "string",
      "pattern": "\\.tmj$"
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "facing": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ]
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "toMapId",
          "viaSpawnId",
          "targetSpawnId"
        ],
        "additionalProperties": false,
        "properties": {
          "toMapId": {
            "type": "string",
            "minLength": 1
          },
          "viaSpawnId": {
            "type": "string",
            "minLength": 1
          },
          "targetSpawnId": {
            "type": "string",
            "minLength": 1
          },
          "requiresFlags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "encounterTableIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "npcRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scriptRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "musicId": {
      "type": "string",
      "minLength": 1
    }
  }
}
