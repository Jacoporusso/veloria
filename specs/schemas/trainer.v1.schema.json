{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veloria TrainerDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aiProfileId",
    "battleOnceFlag",
    "rewardMoney",
    "team"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "victoryFeedback": {
      "type": "string",
      "minLength": 1
    },
    "aiProfileId": {
      "type": "string",
      "minLength": 1
    },
    "battleOnceFlag": {
      "type": "string",
      "minLength": 1
    },
    "rewardMoney": {
      "type": "integer",
      "minimum": 0
    },
    "team": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "speciesId",
          "level",
          "moveIds"
        ],
        "additionalProperties": false,
        "properties": {
          "speciesId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 251
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "moveIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
