{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veloria QuestDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "displayName",
    "steps",
    "completionFlag"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "trigger",
          "setFlag"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "setFlag": {
            "type": "string",
            "minLength": 1
          },
          "requiresFlags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "completionFlag": {
      "type": "string",
      "minLength": 1
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "money": {
          "type": "integer",
          "minimum": 0
        },
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
