{
  "name": "veloria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:battle": "node --experimental-strip-types --test tests/battle/*.test.ts tests/encounters/*.test.ts tests/services/*.test.ts tests/world/*.test.ts",
    "test:persistence": "node --experimental-strip-types --test tests/persistence/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.ts tests/e2e/offline.spec.ts tests/e2e/gen1-offline.spec.ts",
    "test:art-budget": "node --experimental-strip-types --test tests/tools/art-budget.test.mjs",
    "test": "npm run test:battle && npm run test:persistence && npm run test:art-budget"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
